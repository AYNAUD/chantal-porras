---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-500.css';
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  titre?: string;
  description?: string;
  image?: string;
  /** Données structurées schema.org (JSON-LD) propres à la page. */
  donnees?: Record<string, unknown> | Record<string, unknown>[];
  /** Type Open Graph : « website » par défaut, « article » pour une fiche. */
  typeOg?: string;
}

const {
  titre,
  description = 'Chantal Porras, sculptrice à Nîmes. Sculpture animalière, portraits et figures.',
  image = '/images/oeuvres/grizzly.jpg',
  donnees,
  typeOg = 'website',
} = Astro.props;

const titrePage = titre ? `${titre} · ${site.nom}` : `${site.nom} · Sculptrice`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const chemin = Astro.url.pathname;

const menu = [
  { href: '/oeuvres/', libelle: 'Œuvres' },
  { href: '/demarche/', libelle: 'Démarche' },
  { href: '/atelier/', libelle: "L'atelier" },
  { href: '/actualites/', libelle: 'Actualités' },
  { href: '/archives/', libelle: 'Archives' },
  { href: '/contact/', libelle: 'Contact' },
];
// Identité de l'artiste, répétée sur chaque page pour les moteurs de recherche.
const artiste = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${Astro.site}#artiste`,
  name: site.nom,
  jobTitle: site.metier,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  telephone: site.telephones.map((t) => `+33 ${t.slice(1)}`),
  address: { '@type': 'PostalAddress', addressLocality: 'Nîmes', addressRegion: 'Gard', addressCountry: 'FR' },
  knowsAbout: ['Sculpture', 'Sculpture animalière', 'Bronze'],
};
const jsonLd = [artiste, ...(donnees ? [donnees].flat() : [])];

const actif = (href: string) =>
  chemin.startsWith(href) || (href === '/oeuvres/' && chemin.startsWith('/collections/'));
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titrePage}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonique}>
  <meta name="author" content={site.nom}>
  <meta name="theme-color" content="#F6F4F0">
  <meta property="og:type" content={typeOg}>
  <meta property="og:site_name" content={site.nom}>
  <meta property="og:url" content={canonique}>
  <meta property="og:title" content={titrePage}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="fr_FR">
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap.xml">
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
  <header class="conteneur entete">
    <a href="/" class="marque">{site.nom}</a>
    <details class="menu-mobile">
      <summary>Menu</summary>
      <nav aria-label="Navigation principale (mobile)">
        {menu.map((m) => <a href={m.href} aria-current={actif(m.href) ? 'page' : undefined}>{m.libelle}</a>)}
      </nav>
    </details>
    <nav class="menu" aria-label="Navigation principale">
      {menu.map((m) => <a href={m.href} aria-current={actif(m.href) ? 'page' : undefined}>{m.libelle}</a>)}
    </nav>
  </header>

  <main id="contenu">
    <slot />
  </main>

  <footer class="pied">
    <div class="conteneur pied-grille">
      <a href="/" class="marque">{site.nom}</a>
      <nav class="pied-menu" aria-label="Plan du site">
        {menu.map((m) => <a href={m.href}>{m.libelle}</a>)}
      </nav>
      <span>Atelier à {site.ville}<br>Visites sur rendez-vous</span>
      <span>
        <a href={`mailto:${site.email}`}>{site.email}</a><br>
        {site.telephones.map((t, i) => <>{i > 0 && ' · '}<a href={`tel:${t.replace(/\s/g, '')}`}>{t}</a></>)}
      </span>
      <span>© {new Date().getFullYear()} {site.nom}</span>
    </div>
  </footer>
</body>
</html>

<style>
  .entete {
    padding-block: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    align-items: baseline;
    justify-content: space-between;
  }
  .marque { font-family: var(--serif); font-size: 30px; letter-spacing: 0.04em; line-height: 1; }
  .menu, .menu-mobile nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .menu a, .menu-mobile a { padding-block: 8px; }
  [aria-current='page'] { border-bottom: 1px solid currentColor; }
  .menu-mobile { display: none; }
  .menu-mobile summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .menu-mobile summary::-webkit-details-marker { display: none; }

  @media (max-width: 720px) {
    .entete { align-items: center; padding-block: 20px; }
    .marque { font-size: 26px; }
    .menu { display: none; }
    .menu-mobile { display: block; }
    .menu-mobile[open] { flex-basis: 100%; order: 3; }
    .menu-mobile[open] summary { justify-content: flex-end; }
    .menu-mobile nav { flex-direction: column; gap: 4px; padding-top: 8px; }
  }

  .pied { border-top: 1px solid var(--filet); margin-top: 0; }
  .pied-grille {
    padding-block: 48px 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    justify-content: space-between;
    font-size: 14px;
    color: var(--texte-doux);
  }
  .pied .marque { font-size: 24px; color: var(--texte); }
  .pied a:not(.marque) { border-bottom: 1px solid transparent; }
  .pied a:not(.marque):hover { border-color: currentColor; }
  .pied-menu { display: grid; grid-template-columns: repeat(2, auto); gap: 2px 32px; align-content: start; }
</style>
