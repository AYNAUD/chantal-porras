---
import Visuel from './Visuel.astro';

interface Props {
  oeuvre: { slug: string; titre: string; annee: number; image: string };
}

const { oeuvre } = Astro.props;
---
<a class="carte" href={`/oeuvres/${oeuvre.slug}/`}>
  <Visuel src={oeuvre.image} alt={oeuvre.titre} />
  <span class="titre">{oeuvre.titre}</span>
  <span class="annee">{oeuvre.annee}</span>
</a>

<style>
  .carte { display: flex; flex-direction: column; gap: 12px; }
  .titre { font-family: var(--serif); font-size: clamp(18px, 2.4vw, 22px); font-style: italic; line-height: 1.2; }
  .annee { font-size: 13px; color: var(--texte-discret); margin-top: -8px; }
  .carte:hover .titre { color: var(--accent); }
</style>
